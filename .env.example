# ==============================================================================
# ChakraSaakshya - Environment Configuration Template
# Reusable framework variables only. No secrets or production credentials.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME="ChakraSaakshya Foundation API"
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true

# Allowed CORS Origins (comma-separated list for local development)
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Future Database Connection Parameters (Configured during hackathon kickoff)
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=chakra_saakshya_custody

# Frontend Public API URL (used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:8000
